{
  "productName": "TomLauncher",
  "version": "2.0.0",
  "identifier": "com.tomlauncher",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TomLauncher V2",
        "width": 756,
        "height": 280,
        "resizable": true,
        "minWidth": 320,
        "minHeight": 240,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
